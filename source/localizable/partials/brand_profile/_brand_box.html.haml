#brandBox
  .loading
    = brand_profile_partial "loading", locals: { message_key: "brand_overview" }
  .result

  .template._brand-item.brand-profile
    = section :navy do
      .row.justify-content-center
        .brand-profile-content.col-12
          .brand-profile-panel
            .row.brand.mx-0
              .col-sm-6
                %a._wikirate-link.h2.white{href: "replaced_by_js", target: "_wikirate" }
                  %span._brand_name

                .my-4
                  %select.year-select._year-select.btn
                    - %w[2026 2025 2024 2023 2022 2021 2020].each do |year|
                      %option{ value: year, selected: (year == "2026") }
                        = year

                //.pt-4.logo-box
                //   %img._logo.logo{ src: "replace" }

              .col-sm-6.pl-1
                .row.mx-0.py-2
                = property :headquarters
                .row.border-top.mx-0.py-2
                  .col-sm-5.pl-0
                    = t('brands_owned_by')
                    %span._brand_name
                    = ":"
                  .col-sm-7.pr-0._sub_brand_list.list-unstyled
                //= property :revenue
                //= property :profit
                //= property :top_3_production_countries

            %nav.brand-profile-local-nav._brand-profile-local-nav{ "aria-label" => t("brand_profile_navigation.overview_label") }
              .brand-profile-nav-scroll
                %a.brand-profile-local-nav-link{ href: "#living-wage" }= t("brand_profile_navigation.living_wage")
                %a.brand-profile-local-nav-link{ href: "#standards-commitments" }= t("brand_profile_navigation.standards_commitments")
                %a.brand-profile-local-nav-link{ href: "#grievance-mechanism" }= t("brand_profile_navigation.grievance_mechanism")

            .row.brand.mx-0.mt-3#living-wage
              = brand_profile_partial "score/living_wage"
            .row.brand.mx-0.mt-3
              .col-sm-6.pl-0
                = brand_profile_partial "score/transparency"
              .col-sm-6.pr-0.pl-1
                = brand_profile_partial "score/commitment"

            .row.brand.mx-0.mt-4
              .col-12.section.pl-0.pr-0.extended-brand-profile#standards-commitments
                %h6.section-eyebrow= t("brand_profile_extended.eyebrow")
                .display-4.yellow.pb-3= t("brand_profile_extended.title")
                %p.extended-brand-profile-intro= t("brand_profile_extended.intro")

                .status-legend
                  .status-legend-item
                    %span.status-indicator.is-active
                    %span.pl-2
                      = t("brand_profile_extended.legend.active")
                  .status-legend-item
                    %span.status-indicator
                    %span.pl-2
                      = t("brand_profile_extended.legend.inactive")

                = brand_profile_partial "status_group", locals: { key: "multistakeholder_initiatives", index: "01", items: [{ key: "fair_labor_association", short: "FLA" }, { key: "fair_wear_foundation", short: "FWF" }, { key: "ethical_trading_initiative", short: "ETI" }, { key: "better_cotton" }, { key: "cascale" }] }

                = brand_profile_partial "status_group", locals: { key: "binding_agreements", index: "02", items: [{ key: "international_accord" }, { key: "bangladesh_accord" }, { key: "pakistan_accord" }, { key: "act_cambodia" }] }

                = brand_profile_partial "status_group", locals: { key: "non_binding_agreements", index: "03", items: [{ key: "industriall_gfa" }, { key: "act" }] }

                = brand_profile_partial "status_group", locals: { key: "mhrdd_coverage", index: "04", items: [{ key: "csrd" }, { key: "csddd" }, { key: "norwegian_transparency_act" }, { key: "duty_of_vigilance" }] }

                .grievance-mechanism#grievance-mechanism
                  %h6.section-eyebrow.pt-4= t("brand_profile_extended.grievance.eyebrow")
                  .display-5.white.pb-2= t("brand_profile_extended.grievance.title")
                  %p.extended-brand-profile-intro= t("brand_profile_extended.grievance.intro")
                  .row
                    .col-md-4.pb-3
                      = brand_profile_partial "grievance_card", locals: { key: "email", icon: "envelope" }
                    .col-md-4.pb-3
                      = brand_profile_partial "grievance_card", locals: { key: "hotline", icon: "phone" }
                    .col-md-4.pb-3
                      = brand_profile_partial "grievance_card", locals: { key: "online", icon: "link" }
