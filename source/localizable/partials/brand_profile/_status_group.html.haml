.status-group{ class: "_status-group-#{key}" }
  .d-flex.justify-content-between.align-items-end.flex-wrap
    .status-group-header
      %h6.status-group-title
        %span.status-group-index= index
        = t("brand_profile_extended.groups.#{key}.title")
      %p.status-group-copy= t("brand_profile_extended.groups.#{key}.description")
    .status-group-count
      %span{ class: "_status-group-count-#{key}" }= "0/#{items.length}"
  .row.mx-n2
    - items.each do |item|
      .col-md-6.px-2.pb-3
        = brand_profile_partial "status_item", locals: { group_key: key, item: item }
